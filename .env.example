# Admin panel credentials. Generate real values with:
#   node scripts/setup-admin.mjs
# then copy them into .env.local (git-ignored). Do NOT commit real secrets.

# Login (username) for admin.apexgold.cz — defaults to "admin" if unset
ADMIN_USERNAME=admin

# Login password for admin.apexgold.cz
ADMIN_PASSWORD=change-me

# Base32 TOTP secret shared with your authenticator app (Google Authenticator, 1Password, Authy…)
ADMIN_TOTP_SECRET=

# Random key used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# Optional: override where the SQLite file is stored (defaults to ./data/apexgold.db)
# APEXGOLD_DB_PATH=/var/lib/apexgold/apexgold.db

# Optional: override where the append-only journal of submitted applications
# is written (defaults to leads.jsonl next to the database above)
# APEXGOLD_LEAD_LOG=/var/lib/apexgold/leads.jsonl

# Google Analytics Measurement ID. Loaded only after the visitor accepts
# analytics cookies in the consent banner (components/CookieConsent.tsx).
NEXT_PUBLIC_GA_ID=

# Google Tag Manager container. Unlike GA above, the container loads on every
# page view — Consent Mode v2 keeps every storage signal denied until the
# visitor accepts. Leave empty to fall back to the id in lib/gtm.ts.
NEXT_PUBLIC_GTM_ID=

# Telegram bot that mirrors every new lead. Create a bot with @BotFather to
# get the token, then run:
#   node scripts/setup-telegram.mjs
# once (after deploying) to register the webhook and generate the secret.
# Anyone who presses "Start" on the bot starts receiving new leads.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
