# Runtime environment for the `app` container (docker-compose.yml → env_file).
# Copy to .env.docker on the server and fill in real values — .env.docker is
# git-ignored by the existing `.env*` rule.
#
# NEXT_PUBLIC_GA_ID and NEXT_PUBLIC_GOOGLE_ADS_ID are NOT listed here on
# purpose: they are inlined into the client bundle during `next build`, so they
# are passed as build args in docker-compose.yml instead.

# --- Admin panel (admin.apexgold.cz) ---------------------------------------
# Generate the values with `node scripts/setup-admin.mjs` (writes .env.local)
# and copy the four lines it produces over to here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=

# --- Telegram lead notifications -------------------------------------------
# Token from @BotFather. The webhook secret is generated by
# `node scripts/setup-telegram.mjs https://apexgold.cz`, which has to run once
# against the deployed site — copy the secret it writes to .env.local here and
# redeploy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
